{
  "name": "tuff-core",
  "type": "module",
  "files": [
    "*"
  ],
  "version": "2.3.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/Terrier-Tech/tuff"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepub": "tsc && mkdir -p ./dist/ && rm -rf dist/* && cp -a ./src/*.ts ./dist/ && tsx src/gen/publish.ts ",
    "pub": "npm publish ./dist",
    "check": "tsc",
    "gen": "tsx src/gen/dom.ts",
    "test": "vitest",
    "typedoc": "typedoc --plugin typedoc-plugin-extras --footerDate"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "rollup-plugin-folder-input": "^1.0.1",
    "sass": "^1.81.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typedoc": "^0.28.20",
    "typedoc-plugin-extras": "^4.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "path-to-regexp": "^6.3.0",
    "typesafe-routes": "^10.0.6"
  }
}
